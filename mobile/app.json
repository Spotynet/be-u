    "icon": "./assets/images/nabbi_logo.png",
    "scheme": "nabbi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beu.nabbi",
      "config": {
