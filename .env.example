# Secrets live in backend/.env (gitignored). Domains come from ./dev.sh / ./deploy.sh.
#
# Copy keys from backend/.env.example into backend/.env:
#   SECRET_KEY, DEBUG, DB_*, AWS_*, GOOGLE_*, EMAIL_*, …
#
# Optional:
#   web/.env.local     — NEXT_PUBLIC_API_URL (overridden by ./dev.sh in Compose)
#   mobile/.env        — EXPO_PUBLIC_* extras
#
# Shared EC2 gateway: 127.0.0.1:3020
# Internal: api 3007, web 3008, mobile 3009
