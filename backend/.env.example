# Copy to .env in this directory (same folder as manage.py):
#   cp .env.example .env
# Then edit .env with real secrets. Never commit .env.

# --- Django core ---
SECRET_KEY=generate-a-long-random-string-for-production
DEBUG=True

# --- PostgreSQL (RDS / Aurora: use writer endpoint as DB_HOST; create DB + user in RDS first) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nabbi_dev
DB_USER=your_rds_app_user
DB_PASSWORD=your_rds_app_password
DB_HOST=your-cluster.cluster-xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
# RDS/Aurora often requires TLS; omit for local Postgres without SSL
# DB_SSLMODE=require

# --- Media uploads: S3 (django-storages). Set USE_S3=False for local disk only. ---
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
# Optional: CloudFront or custom hostname (no https://). If unset, bucket virtual-hosted URL is used.
# AWS_S3_CUSTOM_DOMAIN=d1234567890abcdef.cloudfront.net

# --- Google OAuth (Calendar + login callbacks). Override staging defaults from code. ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Backend URLs that match Google Cloud Console "Authorized redirect URIs"
GOOGLE_REDIRECT_URI=https://your-api-host/api/calendar/callback/
GOOGLE_REDIRECT_URI_AUTH=https://your-api-host/api/auth/google/callback/
# Optional: Fernet key for token encryption; if unset, derived from SECRET_KEY in code paths that need it
# GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Google Maps (Geocoding / maps proxy endpoints) ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Email (defaults: console backend = print only, no SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real SMTP (e.g. Gmail), use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@be-u.ai
