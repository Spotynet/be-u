# Nabbi / be-u project nginx — hostnames from env (./dev.sh / ./deploy.sh).
# Official nginx image runs envsubst on /etc/nginx/templates/*.template
#
# Docker embedded DNS + variables so missing optional upstreams (e.g. mobile)
# do not prevent nginx from starting.

resolver 127.0.0.11 valid=10s ipv6=off;

# Next.js web
server {
    listen 80;
    server_name ${NABBI_WEB_HOST};

    location / {
        set $nabbi_web web:3008;
        proxy_pass http://$nabbi_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Expo mobile web (optional — may be down during rebuild)
server {
    listen 80;
    server_name ${NABBI_MOBILE_HOST};

    location / {
        set $nabbi_mobile mobile:3009;
        proxy_pass http://$nabbi_mobile;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Django API
server {
    listen 80;
    server_name ${NABBI_API_HOST};

    location / {
        set $nabbi_api api:3007;
        proxy_pass http://$nabbi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
    }
}

# Local curls without Host → Next.js web
server {
    listen 80 default_server;
    server_name _;

    location / {
        set $nabbi_web web:3008;
        proxy_pass http://$nabbi_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
