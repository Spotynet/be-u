# Nabbi / be-u project nginx — hostnames from env (./dev.sh / ./deploy.sh).
# Official nginx image runs envsubst on /etc/nginx/templates/*.template
#
# Docker embedded DNS + variables so missing optional upstreams (e.g. mobile)
# do not prevent nginx from starting.

resolver 127.0.0.11 valid=10s ipv6=off;

# Prefer the outer TLS terminator's scheme (host nginx sets https). Falling back
# to $scheme alone overwrites that with http and breaks secure cookies / redirects.
map $http_x_forwarded_proto $nabbi_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Next.js web
server {
    listen 80;
    server_name ${NABBI_WEB_HOST};

    # Always send /api to Django (never Next.js). Next :path* rewrites drop the
    # trailing slash → Django APPEND_SLASH 301 loop (POST becomes GET in browsers).
    location /api {
        set $nabbi_api api:3007;
        proxy_pass http://$nabbi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        client_max_body_size 50m;
    }

    location / {
        set $nabbi_web web:3008;
        proxy_pass http://$nabbi_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Expo mobile web (optional — may be down during rebuild)
server {
    listen 80;
    server_name ${NABBI_MOBILE_HOST};

    location / {
        set $nabbi_mobile mobile:3009;
        proxy_pass http://$nabbi_mobile;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Django API
server {
    listen 80;
    server_name ${NABBI_API_HOST};

    location / {
        set $nabbi_api api:3007;
        proxy_pass http://$nabbi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        client_max_body_size 50m;
    }
}

# Unknown Host (misconfigured NABBI_*_HOST) or local curls without Host.
# /api must still hit Django — otherwise Next.js rewrite 301s surface as register failures.
server {
    listen 80 default_server;
    server_name _;

    location /api {
        set $nabbi_api api:3007;
        proxy_pass http://$nabbi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        client_max_body_size 50m;
    }

    location / {
        set $nabbi_web web:3008;
        proxy_pass http://$nabbi_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nabbi_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
