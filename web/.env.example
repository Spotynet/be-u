# Must match mobile/.env EXPO_PUBLIC_API_URL (same Django backend as the mobile app).
# Include the /api suffix.
NEXT_PUBLIC_API_URL=https://nabbi-api-dev.spotynet.com/api

# Next.js rewrites only — local/compose Django origin (not used when browser calls nabbi-api-dev directly).
BACKEND_ORIGIN=http://127.0.0.1:3007
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:3007

# Google Maps JavaScript API key for explore map markers (browser).
# Places autocomplete uses the Django proxy (/google-maps/places/*) with backend GOOGLE_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Calendar OAuth redirect (must match Google Cloud Console + Django allowlist).
# Defaults to window.location.origin + /calendar/callback when unset.
# Examples: https://nabbi-dev.spotynet.com/calendar/callback  or  http://localhost:3000/calendar/callback
NEXT_PUBLIC_CALENDAR_REDIRECT_URI=
