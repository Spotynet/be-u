# Copy to deploy.env (gitignored) on builder and prod hosts.
#   cp deploy.env.example deploy.env
#
# Non-secret ECR / deploy config only. Do NOT put AWS access keys here —
# use an EC2 instance role (or ambient AWS creds) for ECR push/pull.
# App secrets stay in backend/.env.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Derived automatically if unset:
# NABBI_IMAGE_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/apps/nabbi
# Optional overrides:
# NABBI_IMAGE_PREFIX=apps/nabbi
# NABBI_IMAGE_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/apps/nabbi

# deploy.sh default floating tag = git default branch (this repo: master)
NABBI_IMAGE_TAG=master

# Optional domain overrides for deploy.sh
# NABBI_WEB_HOST=be-u.ai
# NABBI_API_HOST=api.be-u.ai
# NABBI_MOBILE_HOST=app.be-u.ai
